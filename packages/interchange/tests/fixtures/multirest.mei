<?xml version="1.0" encoding="UTF-8"?>
<!--
  Como las verdades de PrIMuS: un silencio de varios compases (<multiRest>) y después notas.
  converter21 lo sustituye por un silencio de compás entero oculto, que en la partitura se ve (#218).
-->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="4.0.0">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title />
            </titleStmt>
            <pubStmt />
        </fileDesc>
    </meiHead>
    <music>
        <body>
            <mdiv>
                <score>
                    <scoreDef meter.count="3" meter.unit="4">
                        <staffGrp>
                            <staffDef clef.shape="G" clef.line="2" n="1" lines="5" />
                        </staffGrp>
                    </scoreDef>
                    <section>
                        <measure right="single">
                            <staff n="1">
                                <layer n="1">
                                    <multiRest num="4" />
                                </layer>
                            </staff>
                        </measure>
                        <measure right="single">
                            <staff n="1">
                                <layer n="1">
                                    <note dur="4" oct="4" pname="g" />
                                    <rest dur="4" />
                                    <note dur="4" oct="5" pname="c" />
                                </layer>
                            </staff>
                        </measure>
                    </section>
                </score>
            </mdiv>
        </body>
    </music>
</mei>
