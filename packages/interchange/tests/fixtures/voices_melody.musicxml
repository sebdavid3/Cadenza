<?xml version="1.0" encoding="UTF-8"?>
<!--
  Una sola voz con huecos, para #218: en el compás 1 calla una negra entre dos notas (<forward>);
  el compás 2 empieza con un silencio invisible.
-->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Melodía</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>3</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><type>quarter</type>
        <notations><articulations><tenuto/></articulations></notations></note>
      <forward><duration>2</duration></forward>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="2">
      <note print-object="no"><rest/><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><type>half</type></note>
    </measure>
  </part>
</score-partwise>
