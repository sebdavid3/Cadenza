# Variables de entorno para despliegue con Docker Compose (#6)
CADENZA_POSTGRES_DB=cadenza
CADENZA_POSTGRES_USER=cadenza
CADENZA_POSTGRES_PASSWORD=your_secure_password_here
CADENZA_DATABASE_URL=postgresql+psycopg2://cadenza:your_secure_password_here@postgres:5432/cadenza
# Clave de firma de los JWT: genérala con openssl rand -hex 32 (al menos 32 bytes).
# Vacía, la API no arranca: así nadie firma con una clave publicada en el repositorio.
CADENZA_AUTH_SECRET_KEY=
CADENZA_CORS_ORIGINS=*
CADENZA_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
CADENZA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Registro público (ADR-0022): solo con CORS limitado al origen de la interfaz y detrás de
# un proxy que dé la IP real (si no, el límite por IP es uno solo para todo el servicio).
CADENZA_REGISTRATION_ENABLED=false
CADENZA_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
CADENZA_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
CADENZA_DISABLE_POWER_THROTTLING=true
