# Variables del despliegue público con docker-compose.prod.yml (#156, ADR-0023).
# Copia este archivo como .env junto al compose, rellena los secretos EN EL SERVIDOR y protégelo:
#   chmod 600 .env
# Los secretos se generan allí, por ejemplo con: openssl rand -hex 32
# Nunca se comitean ni se copian a otro sitio (ADR-0015).

# Origen público exacto (esquema://host, sin barra final): CORS de la API.
CADENZA_PUBLIC_ORIGIN=https://r2d2.tailcacb19.ts.net

# Secretos (obligatorios).
CADENZA_AUTH_SECRET_KEY=
CADENZA_POSTGRES_PASSWORD=

# Base de datos.
CADENZA_POSTGRES_DB=cadenza
CADENZA_POSTGRES_USER=cadenza

# Puerto local del servicio web (solo 127.0.0.1); Tailscale Funnel lo publica con HTTPS.
CADENZA_WEB_PORT=8380

# Registro de cuentas (ADR-0022, ADR-0025): abierto, la cuenta entra en el momento, limitado
# por IP. Solo «true» o «false»: la API admitiría también 1, yes u on, pero el
# build de la interfaz compara con «true» y dejaría los enlaces al registro ocultos.
CADENZA_REGISTRATION_ENABLED=true
CADENZA_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
CADENZA_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Transcripciones que la API admite a la vez; HOMR calcula de una en una (ADR-0024).
CADENZA_TRANSCRIBE_MAX_CONCURRENCY=2

# Límite de intentos del inicio de sesión (ADR-0015).
CADENZA_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
CADENZA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

