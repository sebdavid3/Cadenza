# Copia este archivo como .env.local para cambiar los valores por defecto.

# URL base de la API que usa el navegador. Por defecto /api, que el servidor de
# desarrollo de Vite (y `vite preview`) reenvía al backend quitando el prefijo.
# En un despliegue sin proxy, la URL de la API (p. ej. https://api.ejemplo.org);
# su origen debe figurar en CADENZA_CORS_ORIGINS del backend.
# VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo (no llega al navegador).
# CADENZA_API_PROXY_TARGET=http://127.0.0.1:8000

# Enlazar el registro público desde la landing y el acceso (ADR-0022). Debe coincidir con
# CADENZA_REGISTRATION_ENABLED de la API.
# VITE_REGISTRATION_ENABLED=true
